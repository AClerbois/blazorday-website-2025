@page "/speakers/{Id}"
@using Sot.BlazorDay2025.Website.Extensions

<div>

    <FluentStack Margin="@Margin.Vertical6">
        <FluentSpacer />
        <FluentAnchorButton Appearance="ButtonAppearance.Subtle"
                            IconStart="@(new Icons.Regular.Size20.ArrowStepBack())"
                            Href="/speakers">
            All speakers
        </FluentAnchorButton>
    </FluentStack>

    @if (Speaker is null)
    {
        <FluentText>I think you've found a bug: this speaker is not known to our event.</FluentText>
    }

    else
    {
        <FluentGrid>
            <FluentGridItem Xs="12" Md="3">
                <FluentImage Source="@Speaker.PhotoUrl"
                             Fit="ImageFit.Contain"
                             Shape="ImageShape.Circular"
                             Width="200px"
                             Height="200px" />
            </FluentGridItem>
            <FluentGridItem Xs="12" Md="9">
                <FluentStack Orientation="Orientation.Vertical">

                    <FluentText Weight="TextWeight.Bold" Size="TextSize.Size700" Color="Color.Custom" CustomColor="var(--blazorday-color)">
                        @Speaker.Name
                    </FluentText>

                    <FluentText Weight="TextWeight.Bold" Color="Color.Custom" CustomColor="var(--blazorday-color)">
                        @Speaker.Company
                    </FluentText>

                    <FluentText Weight="TextWeight.Bold" Margin="@Margin.Vertical4">
                        @Speaker.Title
                    </FluentText>

                    <FluentText Style="text-align: justify;" Margin="@Margin.Bottom4">
                        @Speaker.Description.FormatMarkdown()
                    </FluentText>

                    <FluentStack>
                        <a href="@Speaker.Linkedin" target="_blank" class="speaker-link my-1">
                            <img src="/img/logo-linkedin.png" alt="linkedin" style="width: 18px;" />
                            LinkedIn
                        </a>

                        <FluentSpacer />

                        <a href="@Speaker.WebSite" target="LinkTarget.Blank" class="speaker-link my-1">
                            <img src="/img/logo-web.png" alt="Web site" style="width: 18px;" />
                            Web site
                        </a>
                    </FluentStack>

                    <FluentText Weight="TextWeight.Bold" Color="Color.Custom" CustomColor="var(--blazorday-color)" Margin="48px 0 16px 0">
                        Sessions:
                    </FluentText>

                    @foreach (var session in Speaker.Sessions)
                    {
                        <FluentStack VerticalAlignment="VerticalAlignment.Center">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowCircleRight())" Margin="@Margin.Right2" />
                            <FluentLink Href="@($"/schedule/{session.Id}")">
                                @session.Title
                            </FluentLink>
                        </FluentStack>
                    }

                    <div style="min-height: 48px" />

                </FluentStack>
            </FluentGridItem>
        </FluentGrid>
    }

</div>
